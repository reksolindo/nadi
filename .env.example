# ==========================================
# NADI - Network Activity & Data Insight
# Configuration
# ==========================================

# Mikrotik RouterOS API Connection
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=nadi_monitor
MIKROTIK_PASSWORD=your_mikrotik_api_password_here
MIKROTIK_TLS=false
MIKROTIK_TIMEOUT_MS=5000

# Polling Interval (in milliseconds, default: 5000 = 5 seconds)
POLL_INTERVAL_MS=5000

# Server Port (default: 3100)
PORT=3100
HOST=0.0.0.0

# Database Path
DB_PATH=./data/nadi.db

# Office ISP Capacity (Mbps) for aggregate utilization metrics
CAPACITY_MBPS=200

# Simulation / Mock Mode (set to 'true' to simulate dynamic Mikrotik users without physical router)
MOCK_MODE=false
